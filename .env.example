# SentinelDesk Environment Configuration Template
# Copy this file to .env and insert your API key:
# cp .env.example .env

GEMINI_API_KEY=your_gemini_api_key_here

# Safety escalation gate (see safety_gate.py)
# Tickets whose aggregate confidence is below this go to human review.
SENTINEL_CONFIDENCE_THRESHOLD=0.65
# Set to true once all three classifier checkpoints (type, queue, priority) are in models/.
# When true, any ticket that used a keyword fallback classifier is escalated.
SENTINEL_ESCALATE_ON_FALLBACK=false
