# SentinelDesk Environment Configuration Template
# Copy this file to .env and insert your API key:
# cp .env.example .env

# Gemini (optional). Without a key, drafts are extractive and built from retrieved precedents.
GEMINI_API_KEY=your_gemini_api_key_here
# Models to try in order (comma-separated)
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash

# Optional: higher Hugging Face rate limits for the first dataset / bge-m3 download
# HF_TOKEN=

# Safety escalation gate (see safety_gate.py)
# Tickets whose aggregate confidence is below this go to human review.
SENTINEL_CONFIDENCE_THRESHOLD=0.65
# Tickets whose best historical precedent is less similar than this go to human review
# (calibrated: off-topic 0.33-0.55, realistic in-scope tickets 0.60-0.80).
SENTINEL_SIMILARITY_THRESHOLD=0.58
# Escalate any ticket where a classifier had to fall back to keyword rules.
SENTINEL_ESCALATE_ON_FALLBACK=true
# Number of historical precedents retrieved per ticket (problem statement: 3-5).
SENTINEL_TOP_K=3
